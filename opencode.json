{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": ["tsc", "--lsp", "--stdio"]
    },
    "oxlint": {
      "command": ["oxlint", "--lsp"]
    },
    "nixd": {
      "command": ["nixd"]
    },
    "tombi": {
      "command": ["tombi", "lsp"],
      "extensions": [".toml"]
    }
  }
}
