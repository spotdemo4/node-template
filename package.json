{
  "name": "@spotdemo4/node-template",
  "version": "0.6.11",
  "description": "A template for node.js projects",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/spotdemo4/node-template"
  },
  "bin": {
    "node-template": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c && node build/index.js",
    "prepare": "rolldown -c && chmod +x build/index.js",
    "test": "node --test"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.3",
    "rolldown": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
