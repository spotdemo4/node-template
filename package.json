{
  "name": "node-template",
  "version": "0.6.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "node-template": "build/index.js"
  },
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c && node build/index.js",
    "prepare": "rolldown -c && chmod +x build/index.js"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "rolldown": "^1.0.0-rc.16",
    "typescript": "^6.0.2"
  }
}
